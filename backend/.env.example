# Server
NODE_ENV=development
PORT=4000
API_VERSION=v1

# CORS — the deployed Merchant Portal origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://gainbox:gainbox@localhost:5432/gainbox_dev
DATABASE_POOL_MAX=10

# Firebase Authentication — from your service account JSON
# (Project Settings > Service Accounts > Generate new private key).
# All three optional: the server boots without them, and only fails
# (with a clear 500, not a misleading 401) the moment a request is
# actually authenticated without them configured.
# FIREBASE_PRIVATE_KEY: paste the "private_key" value exactly as it
# appears in the JSON, wrapped in quotes — its embedded \n sequences are
# converted back to real newlines by the adapter, so no reformatting needed.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Surfboard (payment infrastructure — see
# src/modules/integrations/surfboard). All optional, same reasoning as
# Firebase above: the server boots without them, and the integration only
# fails — with a clear error — the moment something actually calls it.
# Confirmed against the real Developer Portal: authentication is a static
# API-KEY/API-SECRET header pair (not OAuth), scoped under an
# account-level partner id in the URL (/api/partners/{partnerId}/...).
SURFBOARD_BASE_URL=https://carbon.surfgw.com
SURFBOARD_PARTNER_ID=
SURFBOARD_API_KEY=
SURFBOARD_API_SECRET=
SURFBOARD_REQUEST_TIMEOUT_MS=10000
# Merchant Integration Framework (Sprint 2A) — how often the outbox worker
# polls for queued merchant syncs. Runs regardless of whether the
# SURFBOARD_* credentials above are set.
SURFBOARD_SYNC_POLL_INTERVAL_MS=15000
# Account-level billing plan id for Create Merchant's
# controlFields.transactionPricingPlan (confirmed via the official Surfboard
# Create Merchant docs) — required whenever the partner account has more
# than one billing plan configured. Ask Surfboard/Partner Portal for the
# real plan id (e.g. "SP_SE_Fix129" in their own example).
SURFBOARD_TRANSACTION_PRICING_PLAN=
# HMAC-SHA512 secret Surfboard signs webhook deliveries with (x-webhook-signature
# header) — registered manually in the Surfboard Console, not via any GainBox
# API. Required for POST /webhooks/surfboard to accept anything.
SURFBOARD_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info

# Development Bootstrap — creates exactly one platform-admin from
# BOOTSTRAP_PLATFORM_ADMIN_EMAIL on server startup, if no platform-admin
# exists yet (see src/bootstrap/platformAdminBootstrap.js). Still only
# Google Sign-In: the created account has no password, and no Firebase UID
# until that email actually signs in with Google, at which point Identity
# Sync links it automatically. Leave BOOTSTRAP_ENABLED unset/false in any
# environment that already has a platform-admin (production, staging) —
# it's a no-op there regardless, but there's no reason to leave it on.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=
