# Server
NODE_ENV=development
PORT=4000
API_VERSION=v1

# CORS — the deployed Merchant Portal origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://gainbox:gainbox@localhost:5432/gainbox_dev
DATABASE_POOL_MAX=10

# Firebase Authentication (admin SDK is not wired up yet — see
# src/modules/auth/identityProvider.port.js)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Surfboard (payment infrastructure — see
# src/modules/integrations/surfboard)
SURFBOARD_BASE_URL=https://api.sandbox.surfboard.dev
SURFBOARD_API_KEY=
SURFBOARD_CLIENT_ID=

# Logging
LOG_LEVEL=info
